{
  "name": "quickstart-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bare Node.js backend template: HTTP listener and graceful shutdown.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "python3 ../scripts/test-scaffold.py && python3 ../scripts/check-scaffold.py"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
